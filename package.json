{
  "name": "ecodigitech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:stack": "docker compose up -d",
    "dev:stack:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
