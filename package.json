{
  "name": "ecodigitech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:gates": "node --test tests/ci-gates.test.mjs",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:stack": "docker compose up -d",
    "dev:stack:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
