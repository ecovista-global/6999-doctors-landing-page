{
  "name": "@ecodigitech/site-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/check-css.ts",
    "preview": "vite preview",
    "check:css": "tsx scripts/check-css.ts",
    "test": "node --import tsx --test test/check-css.test.ts test/template-shell.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ecodigitech/content-schema": "workspace:*",
    "@ecodigitech/ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ecodigitech/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
