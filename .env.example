# ==============================================================================
# EcoDigiTech Platform & Client Infrastructure Environment Variables
# Refer to brain/02_TRD.md, brain/03_ARCHITECTURE.md, and brain/10_SECURITY.md
# ==============================================================================

# Core Node Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Engine: PostgreSQL 16 standard SQL)
# Primary database accessed via PgBouncer in transaction mode
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecodigitech?sslmode=disable
# Optional read-replica connection for asynchronous reports/exports (P2)
REPORTING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecodigitech?sslmode=disable

# ------------------------------------------------------------------------------
# Redis (Rate Limiting, Locks, Caching)
# Local Redis 7 or Upstash Serverless REST Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Email Service (Resend - transactional outbox dispatcher)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_dev_placeholder_key
FROM_EMAIL=notifications@doctorsite.in
OPERATOR_EMAIL=ops@ecodigitech.in

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay - P2 Doctor Self-serve UPI/Card Checkout)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder

# ------------------------------------------------------------------------------
# Cloudflare (Custom Hostnames, SSL for SaaS, CDN, DNS)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=cf_placeholder_api_token
CLOUDFLARE_ZONE_ID=cf_placeholder_zone_id
CLOUDFLARE_ACCOUNT_ID=cf_placeholder_account_id

# ------------------------------------------------------------------------------
# Static Storage (Cloudflare R2 Bucket for Rendered Sites)
# ------------------------------------------------------------------------------
R2_BUCKET_NAME=ecodigitech-sites
R2_ACCESS_KEY_ID=r2_placeholder_access_key
R2_SECRET_ACCESS_KEY=r2_placeholder_secret_key
R2_PUBLIC_DOMAIN=https://assets.doctorsite.in

# ------------------------------------------------------------------------------
# Security & Cryptography (AES-256-GCM for Lead PII per DPDP Act 2023)
# Key must be 64 hexadecimal characters (32 bytes)
# ------------------------------------------------------------------------------
LEAD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Authentication (ES256 / HS256 for Access & Refresh Tokens)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_jwt_access_secret_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_minimum_32_characters_long_for_security

# ------------------------------------------------------------------------------
# Site Rendering & Previews
# ------------------------------------------------------------------------------
PREVIEW_DOMAIN_SUFFIX=preview.doctorsite.in
RENDERER_DISPATCH_URL=https://api.github.com/repos/ecodigitech/platform/actions/workflows/render-site.yml/dispatches
GITHUB_RENDERER_PAT=ghp_placeholder_for_renderer_dispatch
